+/// Whether a slow submission logs the pipelines it ran (`VICTORY_LOG_SLOW_PIPELINES=1`):
+/// a hundred names a warning, and a run of the world makes one a frame.
+fn slow_pipelines() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| std::env::var_os("VICTORY_LOG_SLOW_PIPELINES").is_some())
+}
