+/// `VICTORY_TEXTURE_BUDGET_MB`: the bytes of host copies of textures the
+/// title fills that [`room`] allows, if set.
+#[cfg(windows)]
+fn texture_budget() -> Option<u64> {
+    static LIMIT: std::sync::OnceLock<Option<u64>> = std::sync::OnceLock::new();
+    *LIMIT.get_or_init(|| {
+        let mb = std::env::var("VICTORY_TEXTURE_BUDGET_MB").ok()?;
+        mb.trim().parse::<u64>().ok().map(|mb| mb << 20)
+    })
+}
+
+/// Whether the memory [`room`] measures is nearly all used: within an
+/// eighth of its budget. The pass over textures picked by index brings in
+/// no more than the usual amount while this holds (`draw.rs`
+/// `heap_textures`): an 8 GB card's budget is full by the time a world
+/// loads, and a catch-up burst there evicts what it just uploaded.
+#[cfg(windows)]
+pub(crate) fn tight() -> bool {
+    use std::sync::atomic::Ordering::Relaxed;
+    const FLOOR: u64 = 2 << 30;
+    let filled = KINDS[1].load(Relaxed);
+    if let Some(limit) = texture_budget() {
+        return filled.saturating_add(limit / 8) >= limit;
+    }
+    if filled < FLOOR {
+        return false;
+    }
+    match crate::host::host().and_then(|h| h.video_memory()) {
+        Some([budget, used, ..]) => used.saturating_add(budget / 8) >= budget / 10 * 9,
+        None => false,
+    }
+}
