From ef20aa6861df3725bad82bcf3ec3fcfb1119c1d6 Mon Sep 17 00:00:00 2001
From: feinjaneq <niesam928@gmail.com>
Date: Wed, 25 Nov 2026 15:58:52 +0100
Subject: [PATCH 2/3] Shader: a pixel's quad is read through quad reads, helper
 lanes included
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

At a triangle's edge the quad's other pixels are helpers, and wave reads give
zero from them on AMD, so a derivative taken by hand was the whole value, the
texture read that used it took its smallest level, and the edges showed as
lines on car paint, glass and skin. Ported from Belobug's fork (03629f3);
upstream does this after discards only.

🤖 Generated with Codebuff
Co-Authored-By: Codebuff <noreply@codebuff.com>
---
 crates/victory-shader/src/emit/lower.rs | 16 ++++++++++++++--
 1 file changed, 14 insertions(+), 2 deletions(-)

diff --git a/crates/victory-shader/src/emit/lower.rs b/crates/victory-shader/src/emit/lower.rs
index 50bfccf..0ccd726 100644
--- a/crates/victory-shader/src/emit/lower.rs
+++ b/crates/victory-shader/src/emit/lower.rs
@@ -4212,6 +4212,18 @@ impl<'a> Lower<'a> {
 
     /// `x` of lane `src` (in this lane's quad) through quad reads, whose
     /// lane must be a constant.
+    /// Whether a read of another lane of this lane's quad must reach helper
+    /// lanes: in a pixel shader, always. At a triangle's edge the quad's
+    /// other pixels are helpers (and so are discarded ones), which only quad
+    /// reads see: wave reads give 0 from them on AMD, so a derivative taken
+    /// by hand was the whole value there, the texture read that used it took
+    /// its smallest level, and the triangles' edges showed as lines on car
+    /// paint, glass and skin (Belobug's fork, 03629f3; upstream does this
+    /// after discards only).
+    fn helpers_read(&self, quad: bool) -> bool {
+        quad && self.s.pixel
+    }
+
     fn quad_pick(&mut self, x: V, src: V) -> V {
         self.s.flags |= flags::WAVE_OPS;
         let c = self.cur;
@@ -4354,7 +4366,7 @@ impl<'a> Lower<'a> {
                 let t = self.s.m.bin(c, Bin::Or, t, or);
                 self.s.m.bin(c, Bin::Xor, t, xor)
             };
-            let r = if mesh_quad {
+            let r = if mesh_quad || self.helpers_read(quad) {
                 self.quad_pick(x, src)
             } else {
                 self.read_lane(x, src)
@@ -6625,7 +6637,7 @@ impl<'a> Lower<'a> {
                 (src, inside, masks, bound_ctrl)
             }
         };
-        let mut r = if mesh_quad {
+        let mut r = if mesh_quad || self.helpers_read(quad) {
             self.quad_pick(x, src)
         } else {
             self.read_lane(x, src)
