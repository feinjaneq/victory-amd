# The fork checkout is its own repository with its own remote, so it is not
# nested here (git would store a bare pointer and its history would be lost).
_gl79/

# Large and rebuildable: the two SDKs launcher/vendor.ps1 fetches when they are
# missing (AMD's FSR SDK and Microsoft's DirectX 12 Agility SDK).
ffx/
agility/
*.zip

# Run data and saved profile stay local; build and prebuild logs are kept.
# A run log is a session's own: the launcher deletes the previous one when a run
# starts, so they are not tracked either.
gl79-data/*
!gl79-data/launcher/
gl79-data/launcher/run-*.log

# Launcher runtime
launcher/.window/
launcher/server.log
launcher/window.jpg
launcher/window-menu.jpg

# Machine-local
.freebuff/
node_modules/
